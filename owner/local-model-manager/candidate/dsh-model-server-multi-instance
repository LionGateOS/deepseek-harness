#!/usr/bin/env bash
# dsh-model-server-multi-instance — CANDIDATE (not deployed)
#
# Extends dsh-model-server with per-instance port and GPU-UUID identity
# verification. All existing commands work byte-for-byte identically when
# neither MODEL_SERVER_PORT nor MODEL_SERVER_GPU_UUID is set.
#
# CANDIDATE STATUS: This file is under owner/local-model-manager/candidate/
# and has never been copied to the installed launcher path:
#   /home/liongateos/.local/share/liongateos/deepseek-harness-local-models/dsh-model-server
# Do not deploy it without an explicit owner-approved deployment step.
#
# New behavior (only when the env variables below are set):
#   MODEL_SERVER_PORT=8002    — run this instance on port 8002 instead of 8001
#   MODEL_SERVER_GPU_UUID=... — the CUDA_VISIBLE_DEVICES value this instance
#                               was launched with; stop/switch refuse to touch
#                               a process using a different UUID (wrong-instance
#                               guard). When unset, no GPU UUID check is done
#                               (legacy behavior).
#
# Per-instance isolation:
#   - port_in_use, wait_ready, show_status, safe_stop_known all target PORT
#   - start_model writes logs as  .../<name>-p<PORT>.log
#   - systemd unit names include  -p<PORT> suffix (unique per port)
#   - same GGUF can run on two ports simultaneously under different GPU UUIDs
#
# Wrong-instance stop guard (safe_stop_known):
#   When EXPECTED_GPU_UUID is set and the process owning PORT uses a different
#   CUDA_VISIBLE_DEVICES value, the launcher prints a plain refusal and exits 8.
#   It reads the GPU UUID from /proc/<pid>/environ (readable for own processes).
#   Override _MOCK_PROC_ENV_FILE in tests to inject a fake environment file.
#
# Exit codes (superset of original):
#   0  success
#   2  usage error, invalid MODEL_SERVER_PORT, or unsafe runtime directory
#   3  port already in use at start time, or concurrent start already in progress
#   4  server did not become ready within 180 s
#   5  port in use but owning PID could not be verified
#   6  process on the port is not one of our known model servers
#   7  verified server did not release the port after 30 s
#   8  NEW — process on the port uses a different GPU UUID than expected
#   9  NEW — process on the port exists but cannot be signalled (EPERM)
#   10 NEW — ownership record absent, malformed, stale, or unverifiable (Option B)
#
# Ownership records (Option B — fail closed):
#   Every start writes an ownership record to the per-port instance file:
#     ${LOCK_DIR}/instance-p${PORT}.rec
#   The record is written atomically (tmp→rename) only after wait_ready succeeds.
#   safe_stop_known reads the record, queries the unit's MainPID via systemctl,
#   and cross-checks it against the port-owning PID before authorizing the stop.
#   If the record is absent, malformed, stale, or if any PID cross-check fails,
#   the stop is refused with exit 10 and a recovery hint. Records are deleted on
#   successful stop. This launcher never takes ownership of or stops a server it
#   did not start.
#
#   Stale record (record present, port free) — a start on that port is blocked.
#   Recovery: rm "${LOCK_DIR}/instance-p${PORT}.rec"
#
# PORT validation:
#   MODEL_SERVER_PORT must be a plain decimal integer, 1–65535, no leading zeros.
#   This is validated before any URL, filename, or unit name is constructed.
#
# Per-instance launch coordination:
#   start_model acquires an exclusive flock on
#     ${XDG_RUNTIME_DIR}/dsh-launcher/p<PORT>.lock   (preferred)
#     ${HOME}/.local/state/dsh/launcher/p<PORT>.lock  (fallback)
#   The lock directory must be owned by the current user; its permissions are
#   set to 700 at every invocation. Concurrent starts for the same port fail
#   immediately with exit 3; different ports use independent lock files.
#
# Test-mode injection:
#   _DSH_LAUNCHER_TEST_MODE must contain a path to a readable sentinel FILE
#   (not a fixed string like "1"). Tests create the sentinel in their temp dir
#   so it is impossible to activate test mode via an inherited string value.
#
# Multiple Jobs (-np) mode: unchanged from the original. The installed launcher
# hardcodes -np 1 for every model; this candidate does not change that.

set -euo pipefail

