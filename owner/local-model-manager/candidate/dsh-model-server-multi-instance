PORT="${MODEL_SERVER_PORT:-8001}"

# Validate before constructing any URL, filename, unit name, or grep pattern.
# Require a plain decimal integer 1–65535 with no leading zeros.
# Leading zeros are forbidden because bash arithmetic treats them as octal.
if ! [[ "$PORT" =~ ^[1-9][0-9]*$ ]] || (( 10#$PORT > 65535 )); then
  printf 'ERROR: MODEL_SERVER_PORT="%s" is not a valid TCP port (1–65535, no leading zeros).\n' \
    "${MODEL_SERVER_PORT:-<unset>}" >&2
  exit 2
fi

BASE_URL="http://127.0.0.1:${PORT}"

# When set, safe_stop_known refuses to stop a process using a different GPU UUID.
EXPECTED_GPU_UUID="${MODEL_SERVER_GPU_UUID:-}"

