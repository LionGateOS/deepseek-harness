{
  "name": "@local/model-guide-cost-router",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Model Guide & Cost Router: owner-curated guidance overlaid on live provider/model discovery, with deterministic Copy-for-Prompt text, cost-rate-only price storage, and read-only agent guidance tools.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "core/cost.js",
    "core/overlay.js",
    "core/guidance-text.js",
    "core/recommend.js",
    "core/tools.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-ui-sidebar"] }
  }
}